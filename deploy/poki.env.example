# Copy to deploy/poki.env (ignored by git) and fill in. See deploy/README.md.

# The HTTPS origin your front (Tailscale Funnel or Cloudflare Tunnel) serves. Clients connect to
# <this URL>/mcp. Leave it unset for a local-only daemon.
POKI_MCP_PUBLIC_URL=https://poki.your-tailnet.ts.net

# cloudflare-access: Cloudflare Access signs you in (recommended behind Cloudflare Tunnel).
# builtin: this daemon signs you in with password + TOTP (create the account first).
# external: JWT access tokens from another OAuth authorization server (see README).
POKI_OAUTH=builtin

# For cloudflare-access:
# POKI_CF_ACCESS_TEAM=your-team
# POKI_CF_ACCESS_AUD=application-aud-tag
# POKI_OAUTH_ALLOWED_SUBJECTS=you@example.com

# Redirect hosts that dynamic client registration accepts.
POKI_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1

# Stay on loopback; the front connects to 127.0.0.1.
POKI_MCP_BIND=127.0.0.1

# Optional stable token for clients on this machine. Generate with: openssl rand -hex 32
# POKI_MCP_TOKEN=

# Sensitive tools (install/uninstall app, open URL, clipboard, app container, build and run)
# need approval, and a Linux server has no approval dialog, so without this they are refused.
# The operator chose to preapprove them: the OAuth or Access sign-in limits the server to one
# account. It never answers iOS system dialogs or request_human_action. Remove it to refuse them.
POKI_MCP_APPROVAL_MODE=allow

# Several agents at once: serialize input per device, let reads run side by side.
POKI_INPUT_LOCK=1
POKI_INPUT_LOCK_WAIT_MS=30000
POKI_MAX_CONCURRENT_READS=4

# Device routing for the phone over the tailnet (pairing file paths under /pairing in Docker)
# comes from the network-device settings in docs/linux.md.
